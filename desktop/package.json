{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "python:bundle": "python3 scripts/build_python_bundle.py",
    "package": "npm run build && npm run python:bundle && electron-builder"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tar": "^7.4.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.omni.scraper",
    "productName": "OmniScraper",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources-manifest.json"
    ],
    "extraResources": [
      {
        "from": "python_dist",
        "to": "python"
      }
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
